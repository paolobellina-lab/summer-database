rules_version = '2';
// Regole di sicurezza di Cloud Firestore, progetto summer-database.
// Il database è condiviso con le app Scontrini e Spese Ville: mantenere SEMPRE le righe scontrini e scontrini_foto.
// Le email reali sono solo nella console Firebase (questo repository è pubblico).
service cloud.firestore {
  match /databases/{database}/documents {
    function emailUtente() { return request.auth.token.email.lower(); }
    // amministratori: entrano sempre e sono gli unici che possono modificare l'elenco degli account
    function amministratore() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && emailUtente() in ['EMAIL-1@gmail.com', 'EMAIL-2@gmail.com'];
    }
    // account autorizzati: amministratori + elenco gestito dall'app (meta/accessi, campo "emails")
    function autorizzato() {
      return amministratore()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/meta/accessi)
          && emailUtente() in get(/databases/$(database)/documents/meta/accessi).data.emails);
    }
    match /villas/{id}   { allow read, write: if autorizzato(); }
    match /bookings/{id} { allow read, write: if autorizzato(); }
    match /meta/accessi  { allow read: if autorizzato(); allow write: if amministratore(); }
    // lettura di tutta la cartella meta per gli autorizzati; scrittura di meta/accessi solo agli amministratori
    match /meta/{id}     { allow read: if autorizzato(); allow write: if autorizzato() && id != 'accessi'; }
    match /villas_foto/{id}  { allow read, write: if autorizzato(); }
    match /villas_thumb/{id} { allow read, write: if autorizzato(); }
    match /scontrini/{id}      { allow read, write: if autorizzato(); }
    match /scontrini_foto/{id} { allow read, write: if autorizzato(); }
    match /{document=**} { allow read, write: if false; }
  }
}
